# Feature flag. The ordinary site is used unless this is exactly "true".
TDS_ENABLED=false

# Fixed, server-side campaign destination and its exact allowed hostname.
TDS_TARGET_URL=https://dzentds.top/d4h9Jb
TDS_ALLOWED_TARGET_HOSTS=dzentds.top
TDS_CORRELATION_PARAM=sub_id_6

# Required signed server-to-server Palladium decision.
TDS_DECISION_URL=https://api.studiadesi.site/v4/index.php
TDS_SHARED_SECRET=
TDS_KEY_ID=kewabort_online-v1
TDS_SITE_ID=kewabort_online
TDS_TIMEOUT_MS=1200

# Optional: set only after Cloudflare adds the same secret as
# X-TDS-CF-Verified on requests to this hostname. Then CF-Connecting-IP is
# trusted as the original visitor IP; otherwise Vercel's IP header is used.
TDS_CF_PROXY_TOKEN=

# "target" preserves paid traffic during a technical outage; "site" never bypasses Palladium.
TDS_ERROR_FALLBACK=target
